# Modal profile this repo uses (`modal profile list`). Deploys, downloads, the lab and setup_token.py
# stop when another profile is active.
FREEFIELD_MODAL_PROFILE=
# Gateway in front of comfy-api-proxy (the Modal URL printed by `modal deploy infra/modal_app.py`,
# https://<POD_ID>-8000.proxy.runpod.net or https://<ENDPOINT_ID>.api.runpod.ai on RunPod,
# or http://127.0.0.1:8000 when running the gateway locally).
COMFY_BASE_URL=https://YOUR-WORKSPACE--freefield-serve.modal.run
# Written by `python tools/setup_token.py`, which stores the same value in the Modal secret "freefield".
# On a RunPod Serverless endpoint: your RunPod API key.
FREEFIELD_TOKEN=
# RunPod Serverless takes at most 30 MB per request: refuse bigger uploads in the web app up front.
# FREEFIELD_MAX_UPLOAD_MB=28
# Passcode of the hosted demo (infra/web_app.py), written by `python tools/setup_demo.py`; only --link reads it here.
FREEFIELD_DEMO_PASSCODE=
# Let the web UI and the CLI run draft apps too (their workflows have not been run on a GPU yet).
# FREEFIELD_DRAFTS=1
